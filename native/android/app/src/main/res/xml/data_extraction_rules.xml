<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules for Medsprout.
  Medications and notes must stay on the device, so nothing is copied into cloud backups
  (Google Drive). A direct phone-to-phone transfer (cable or Wi-Fi when setting up a new
  phone) still brings everything across, since the data never leaves the person's hands.
  Android 11 and older can't tell the two apart, so android:allowBackup="false" turns
  backups off there; people can still move their data with Settings → Export backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
